generator client {
  provider = "prisma-client"
  output   = "./client"
}

datasource db {
  provider = "postgresql"
}

enum GameStatus {
  idle
  inProgress
  gameOver
  gameOverDraw
}

model Game {
  id         String       @id @default(cuid())
  status     GameStatus
  field      Json?
  players    GamePlayer[] @relation("players")
  winner     GamePlayer?  @relation(fields: [winnerId], references: [id])
  winnerId   String?
  gameOverAt String?
}

model GamePlayer {
  id     String @id @default(cuid())
  gameId String
  game   Game   @relation("players", fields: [gameId], references: [id])
  userId String
  user   User   @relation(fields: [userId], references: [id])
  index  Int
  games  Game[]

  @@unique([gameId, userId])
}

model User {
  id           String       @id @default(cuid())
  login        String
  rating       Int
  passwordHash String
  salt         String
  players      GamePlayer[]
}
