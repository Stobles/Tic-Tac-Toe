generator client {
  provider = "prisma-client"
  output   = "./client"
}

datasource db {
  provider = "postgresql"
}

enum GameStatus {
  idle
  inProgress
  gameOver
  gameOverDraw
}

model Game {
  id         String     @id @default(cuid())
  status     GameStatus
  field      Json?
  players    User[]     @relation("games")
  winner     User?      @relation(fields: [winnerId], references: [id])
  winnerId   String?
  gameOverAt String?
}

model User {
  id           String @id @default(cuid())
  login        String
  rating       Int
  passwordHash String
  salt         String
  games        Game[] @relation("games")
  winnerGames  Game[]
}
